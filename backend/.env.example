# ============================================================
# MedFlow Agent —— 医疗大模型 LLM 云端 API 接入配置（示例模板）
#
# 🎯 全部都是纯云端 API，不做本地部署！复制为 .env 后填空
# 4 大云端厂商（通用模型 × 2 + 真正医疗垂直模型 × 2）
# "通用模型 vs 医疗垂直模型" 区别：
#   · 通用模型：秒开通、价格低，靠强 Prompt + 医疗 RAG 做分诊约束；准确率约 80-88%
#   · 医疗垂直模型：医疗数据训练、专业性强；分诊准确率 >93%，但开通需要资质审核（B端）
# ============================================================
cp .env.example .env # 复制为真实配置文件后再填

# ---------- 基础配置（Demo 默认即可，生产改 JWT_SECRET） ----------
JWT_SECRET=medical-agent-demo-secret-change-me
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---------- SubAgent 默认开关 ----------
DEFAULT_ENABLE_EMR_SUBAGENT=1
DEFAULT_ENABLE_LAB_SUBAGENT=1

# ============================================================
# ★★★ 5 行核心 LLM 配置
# Provider 统一 openai_compatible，4 大厂商全都是 OpenAI 兼容接口
# ============================================================
LLM_PROVIDER=openai_compatible
LLM_ENABLE_TRIAGE_REAL=1      # =1 启用真模型，=0 强制Mock
LLM_API_KEY=                  # ★ 填 Key
LLM_BASE_URL=                 # ★ 从下面 4 套方案中复制 BASE URL
LLM_MODEL=                    # ★ 从下面 4 套方案中复制模型名
LLM_TIMEOUT=30

# ============================================================
# 4 大云端 API 厂商速查表（都改 3 行：KEY / BASE / MODEL）
# ============================================================
#
# ┌────────────────────────────────────────────────────────────────────────────────────────┐
# │ 【① 阿里 DashScope】 通用模型 · 秒开通 · 新用户百万免费Token                            │
# │  归属：阿里达摩院/阿里云（不是百度）                                                   │
# │  开通：https://dashscope.console.aliyun.com/ → API 密钥管理 → 创建 Key（sk- 开头）        │
# │                                                                                │
# │  LLM_API_KEY   = sk-xxxxxx                                                            │
# │  LLM_BASE_URL  = https://dashscope.aliyuncs.com/compatible-mode/v1                      │
# │  LLM_MODEL     = qwen-plus     ← 导诊推荐/性价比最高                                  │
# │                  qwen-max      ← 更强推理/更贵                                        │
# │                  qwen-turbo    ← 最便宜/最快                                          │
# └────────────────────────────────────────────────────────────────────────────────────────┘
#
# ┌────────────────────────────────────────────────────────────────────────────────────────┐
# │ 【② 讯飞医疗 MaaS 平台】 ★真·医疗垂直模型·首推                                           │
# │  归属：科大讯飞 · 国内首个医疗聚焦 MaaS 训练平台                                        │
# │  特点：星火医疗系列是医疗数据深度微调，覆盖医学问答、逻辑推理、病历生成                     │
# │        OpenAI 兼容格式 (/v1/chat/completions)，项目里的适配器直接复用                   │
# │  开通：https://docs.iflyaicloud.com/project-7/ → 注册 → 申请星火医疗服务 → 控制台拿 Key   │
# │                                                                                │
# │  LLM_API_KEY   = <讯飞医疗 MaaS 控制台取 APIKey>                                       │
# │  LLM_BASE_URL  = https://maas-api.cn-huabei-1.xf-yun.com/v2                (2026.1.10 后开通)│
# │                  https://maas-api.cn-huabei-1.xf-yun.com/v1               (2026.1.10 前开通)│
# │  LLM_MODEL     = 星火医疗_X1_ProX  ← 旗舰版，医疗知识最强                               │
# │                  星火医疗_V2_Lite  ← 轻量化/便宜/快                                    │
# └────────────────────────────────────────────────────────────────────────────────────────┘
#
# ┌────────────────────────────────────────────────────────────────────────────────────────┐
# │ 【③ 百度灵医开放平台】 医疗垂直模型 · 北京114挂号平台真实案例 · 分诊准确率>95%                │
# │  归属：百度 · 灵医智惠（不是文心一言）                                                  │
# │  特点：覆盖智能导诊、预问诊、病历生成、报告解读全场景，融合800+医院经验数据                  │
# │  开通：灵医开放平台 → 合作申请 → 商务审核 → 获取 API Key（非秒开通，需企业/医院场景）        │
# │                                                                                │
# │  LLM_API_KEY   = <商务对接后获取>                                                       │
# │  LLM_BASE_URL  = <以商务文档为准>                                                       │
# │  LLM_MODEL     = lingyi-medical-v3   (以最终对接文档为准)                                  │
# └────────────────────────────────────────────────────────────────────────────────────────┘
#
# ┌────────────────────────────────────────────────────────────────────────────────────────┐
# │ 【④ DeepSeek】 通用模型 · 经济实惠 · 新用户 500 万Token免费                              │
# │  归属：深度求索                                                                   │
# │  特点：纯通用模型，但推理能力强、价格低；通用模型里医学问答表现不错                        │
# │  开通：https://platform.deepseek.com → 注册 → API Keys → Create                         │
# │                                                                                │
# │  LLM_API_KEY   = sk-xxxxxx                                                            │
# │  LLM_BASE_URL  = https://api.deepseek.com/v1                                           │
# │  LLM_MODEL     = deepseek-chat     ← 导诊够用                                          │
# │                  deepseek-reasoner ← 思考链推理/复杂症状鉴别                              │
# └────────────────────────────────────────────────────────────────────────────────────────┘

# ============================================================
# 验证命令（填完 Key + URL + MODEL 后运行）
# ============================================================
# cd backend
# python3 scripts/verify_qwen_dashscope.py
# （脚本名写的是 qwen，但其实对所有 4 家厂商同样有效——只要 openai_compatible 都测）
#
# 模型切换不需要改代码 → 改 .env 里 3 行（KEY/BASE_URL/MODEL）→ 重启后端即可
