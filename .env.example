# ===== 医院诊疗 Agent 工作台 Demo 环境变量示例 =====
# 复制为 .env 后按需修改；Demo 不依赖任何真实密钥，全部 Mock。

# 后端服务
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# JWT 配置（Demo 简易签名密钥，请勿用于生产）
JWT_SECRET=medical-agent-demo-secret-change-me
JWT_ALGORITHM=HS256
JWT_EXPIRE_HOURS=12

# 跨域（前端地址）
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# SubAgent 全局默认开关（0=关闭走人工，1=开启调用 Mock LLM）
DEFAULT_ENABLE_EMR_SUBAGENT=1
DEFAULT_ENABLE_LAB_SUBAGENT=1
